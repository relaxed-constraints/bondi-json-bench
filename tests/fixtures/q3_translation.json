    "jsonbench/query_generator/mdb_query_gen.py": "8c754c31ffcb28d3c3dbadf9cd4b26bcd8d7ea38568fe9a87f5719b8092194a3",
    "jsonbench/query_generator/cb_query_gen.py": "e263966dda6b2877f012ec0eff53e521ace6e95d15f2001282c650de34d86cb7"
  },
  "template": {
    "name": "Query 3",
    "description": "Average traveller group size (per booking) for each tour",
    "primary_collection": "bookings",
    "operations": {
      "group": {
        "by": "tour_id",
        "aggregates": {
          "avg_grp_size": "avg(size(travellers))"
        }
      }
    }
  },
  "mongodb_pipeline": [
    {
      "$group": {
        "_id": "$tour_id",
        "avg_grp_size": {
          "$avg": {
            "$size": "$travellers"
          }
        }
      }
    }
  ],
  "couchbase_statement": "SELECT `bookings`.`tour_id` AS `tour_id`, AVG(ARRAY_LENGTH(`bookings`.`travellers`)) AS `avg_grp_size` FROM `bookings` GROUP BY `bookings`.`tour_id`;"
}
